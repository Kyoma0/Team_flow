# Database
DATABASE_URL=postgresql://teamflow:teamflow@localhost:5432/teamflow

# Redis (optional)
REDIS_URL=redis://localhost:6379

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=teamflow

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# SMTP (optional — leave empty to log emails to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@teamflow.app

# CORS
CORS_ORIGIN=http://localhost:3000

# Sentry (optional)
SENTRY_DSN=

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# ASAAS (payment gateway — optional, mock mode if empty)
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_MOCK=true

# App
PORT=3001
NODE_ENV=development
