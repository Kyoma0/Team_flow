# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts
*.sh text eol=lf

# Batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# PowerShell
*.ps1 text eol=crlf
*.psm1 text eol=crlf

# JavaScript/TypeScript
*.js text
*.ts text
*.tsx text
*.jsx text
*.json text
*.css text
*.scss text
*.html text

# Markdown
*.md text

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text

# Archives
*.zip binary
*.tar.gz binary
*.7z binary

# Environment files
.env* text

# Lock files
package-lock.json text
yarn.lock text
